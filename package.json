{
  "name": "@rackctl/docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "shuttering-error-pages --out public --brand rackctl --ground slate --palette slate --home https://docs.rackctl.sh && rm -f public/404.html",
    "build": "astro build",
    "postbuild": "shuttering-error-pages check dist/500.html --status 500 && node scripts/check-build.mjs",
    "preview": "astro preview",
    "og": "node scripts/og-image.mjs",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@shuttering/starlight": "0.2.3",
    "astro": "^7.1.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "2.5.3",
    "@shuttering/error-pages": "0.4.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.4",
      "postcss": "^8.5.18"
    }
  }
}
